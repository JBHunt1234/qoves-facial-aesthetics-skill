# Required: Claude analysis (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: override the analysis model (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Image previews ("what would I look like with...") — set ONE of these.
# Replicate runs FLUX Kontext (best at keeping your identity while editing hair).
REPLICATE_API_TOKEN=
# Optional: override the Replicate model (default black-forest-labs/flux-kontext-pro)
# REPLICATE_MODEL=black-forest-labs/flux-kontext-pro
# Or OpenAI gpt-image-1 edits:
OPENAI_API_KEY=

# Optional: require a passcode so strangers can't spend your API credits.
# APP_ACCESS_CODE=
